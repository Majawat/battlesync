{
  "name": "battlesync",
  "version": "2.25.0",
  "description": "Simple OPR Battle Tracker - Clean v2 rewrite",
  "main": "dist/server.js",
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "tsc && npm run copy:assets",
    "copy:assets": "node -e \"const fs=require('fs');fs.mkdirSync('dist/database',{recursive:true});fs.copyFileSync('src/database/schema.sql','dist/database/schema.sql')\"",
    "build:frontend": "cd frontend && npm run build",
    "build:production": "npm run build:backend && npm run build:frontend",
    "start": "node dist/server.js",
    "start:production": "NODE_ENV=production node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "typecheck": "tsc --noEmit",
    "docker:build": "docker build -t battlesync:latest .",
    "docker:run": "docker run -p 4019:4019 battlesync:latest",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:dev": "docker compose -f docker-compose.dev.yml up",
    "docker:logs": "docker compose logs -f",
    "archive-rules": "tsx scripts/downloadArmyBooks.ts"
  },
  "keywords": [
    "opr",
    "battle",
    "tracker",
    "gaming"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/multer": "^2.3.0",
    "@types/sqlite3": "^3.1.11",
    "axios": "^1.21.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "multer": "^2.5.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.0",
    "@types/supertest": "^7.2.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
